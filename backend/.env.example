# LLM（KSPMAS kimi-k3，Anthropic 兼容端点）
ANTHROPIC_BASE_URL=https://kspmas.ksyun.com/v1/chat/completions
ANTHROPIC_AUTH_TOKEN=replace-with-your-kspmas-key
ANTHROPIC_MODEL=kimi-k3

# seedream 文生图（金山云 KSPMAS，独立配置；api_key 留空时 fallback 用上方 ANTHROPIC_AUTH_TOKEN）
SEEDREAM_BASE_URL=https://kspmas.ksyun.com
SEEDREAM_API_KEY=
SEEDREAM_MODEL=seedream-5.0-pro-domestic

# MySQL（仅 e2e 用；单元/集成测试用 sqlite in-memory，不读此项）
DB_URL=mysql+asyncmy://root:PASSWORD@127.0.0.1:3306/ai_cowork_game?charset=utf8mb4

# Redis（Arq 队列 + 事件流）
REDIS_URL=redis://127.0.0.1:6379/0
ARQ_QUEUE=agent

# workspace 根（相对 repo，project workspace = <repo>/Games/{key}/）
WORKSPACE_ROOT=Games

# === Git（Phase 2，D2） ===
GITHUB_REPO_URL=https://github.com/<owner>/<repo>.git
GITHUB_PAT=
WORKSPACE_ROOT=workspace
GIT_BRANCH_PREFIX=agent

# === Observability (Langfuse) ===
# 两者皆空时后端静默跳过 Langfuse 上报（业务表/聚合 API 仍正常工作）。
# 启动 langfuse 后用其 compose 的 LANGFUSE_INIT_* 自动建项目并固化 key，把同款 key 填于此。
LANGFUSE_PUBLIC_KEY=pk-lf-replace-with-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-replace-with-your-secret-key
LANGFUSE_BASE_URL=http://localhost:3000
